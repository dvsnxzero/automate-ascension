# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# Webull API (live brokerage, read-only by default)
# Get keys at https://www.webull.com/open-api-management
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# Alpaca paper trading API
# Get keys at https://app.alpaca.markets/paper/dashboard/overview
# Switch to "Paper Trading" in the upper-left corner before generating
ALPACA_API_KEY=PK_paper_key_here
ALPACA_API_SECRET=paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Virtual paper equity cap (Alpaca paper defaults to $100k; cap so position
# sizing matches real available capital). Set to 0 to disable.
PAPER_VIRTUAL_EQUITY=11300
PAPER_MARGIN_MULTIPLIER=2.0

# Live trading kill switch — keep false unless you mean it
ENABLE_LIVE_TRADING=false

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://ascension:localdev@localhost:5432/ascension

# App Security
SECRET_KEY=change-me-to-a-random-64-character-string

# Environment (development | production)
ENVIRONMENT=development

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
